# Base de datos Postgres. Si conectas Neon desde Vercel, esta variable se llena sola.
DATABASE_URL=

# Texto largo al azar (mínimo 16 caracteres). Firma las sesiones de inicio de sesión.
AUTH_SECRET=

# Primer administrador. Se crea la primera vez que alguien intenta entrar.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Clave que va dentro de la dirección del webhook que pegas en Chatwoot.
WEBHOOK_TOKEN=

# Conexión con Chatwoot (para responder desde el CRM)
CHATWOOT_URL=https://app.chatwoot.com
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=

# Opcional: dirección pública de tu Chatwoot (https) para mostrarlo en la pestaña Conversaciones.
# Solo funciona si tu Chatwoot permite mostrarse dentro de otra página (en tu propio servidor sí, ver INSTALAR-EN-MI-SERVIDOR.md).
CHATWOOT_PUBLIC_URL=

# Opcional: secreto del webhook que muestra Chatwoot al crearlo (verifica la firma)
CHATWOOT_WEBHOOK_SECRET=
