# Variables para instalar Pulso CRM + Chatwoot en tu servidor.
# scripts/instalar.sh crea el archivo .env a partir de esta plantilla, con contraseñas al azar.
# Si prefieres hacerlo a mano: cp .env.servidor.example .env  y llena todo lo que dice CAMBIAR.

# Direcciones (los dos nombres deben apuntar a la IP de tu servidor)
CRM_DOMAIN=CAMBIAR.crm.tudominio.com
CHAT_DOMAIN=CAMBIAR.chat.tudominio.com

# Tu usuario administrador de Pulso CRM
ADMIN_EMAIL=CAMBIAR@correo.com
ADMIN_PASSWORD=CAMBIAR

# Secretos (el script los genera; si lo haces a mano usa textos largos al azar, por ejemplo: openssl rand -hex 32)
AUTH_SECRET=CAMBIAR
WEBHOOK_TOKEN=CAMBIAR
CHATWOOT_SECRET_KEY_BASE=CAMBIAR
POSTGRES_PASSWORD=CAMBIAR
PULSO_DB_PASSWORD=CAMBIAR
REDIS_PASSWORD=CAMBIAR

# Conexión de Pulso CRM con Chatwoot. Se llenan después, con scripts/conectar-chatwoot.sh
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
# Opcional: secreto del webhook, si tu Chatwoot lo muestra al crearlo
CHATWOOT_WEBHOOK_SECRET=

# Opcionales
# CHATWOOT_TAG=latest-ce       (versión de Chatwoot; por defecto latest)
# CHATWOOT_WEB_CONCURRENCY=1   (procesos web de Chatwoot; súbelo si tienes más memoria)
# CHATWOOT_SIDEKIQ_CONCURRENCY=5
# CHATWOOT_RAILS_THREADS=5
