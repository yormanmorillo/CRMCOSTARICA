# Caddy publica los dos sitios con HTTPS automático (certificados gratis de Let's Encrypt).
{
	email {$ACME_EMAIL}
}

{$CRM_DOMAIN} {
	encode gzip
	reverse_proxy pulso:3000
}

{$CHAT_DOMAIN} {
	encode gzip
	reverse_proxy rails:3000 {
		# Permite que Pulso CRM (y solo él) muestre Chatwoot dentro de su pestaña "Conversaciones".
		header_down -X-Frame-Options
		header_down Content-Security-Policy "frame-ancestors 'self' https://{$CRM_DOMAIN}"
	}
}
