# Variables para Pulso CRM solo (docker-compose.solo.yml). Copia este archivo a .env y cambia lo que dice CAMBIAR.
# Para generar un texto al azar:  openssl rand -hex 24

# Dirección donde vivirá el CRM. Debe apuntar a la IP de tu servidor (registro DNS tipo A).
CRM_DOMAIN=CAMBIAR.crm.tudominio.com

# Tu usuario administrador
ADMIN_EMAIL=CAMBIAR@correo.com
ADMIN_PASSWORD=CAMBIAR

# Secretos
AUTH_SECRET=CAMBIAR
POSTGRES_PASSWORD=CAMBIAR

# WhatsApp directo con Meta (paso a paso en WHATSAPP.md). Se pueden llenar después.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
META_APP_SECRET=
# Una clave que inventas tú (openssl rand -hex 24). Se pega igual en Meta al configurar el webhook.
META_VERIFY_TOKEN=CAMBIAR

# Instagram y Facebook directos (ver ADMIN.md)
META_PAGE_TOKEN=
META_PAGE_ID=
